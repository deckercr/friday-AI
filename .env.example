# GPU
NVIDIA_GPU_UUID=GPU-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AMD_RENDER_NODE=128

# Model paths
MODELS_PATH=/path/to/your/models

# Database
DB_NAME=friday
DB_USER=friday
DB_PASSWORD=changeme

# Security
JWT_SECRET=change-this-to-a-256-bit-random-secret

# GitHub
GITHUB_TOKEN=ghp_yourtoken

# CORS (comma-separated origins; defaults to localhost:5173 in dev)
APP_CORS_ALLOWED_ORIGINS=https://your-domain.com

# Cookie security (set to false only for local HTTP dev; defaults to true)
APP_COOKIE_SECURE=true

# Frontend API base URL (leave empty when Vite proxy handles it in dev)
VITE_API_BASE_URL=https://api.your-domain.com
